# ==============================================================================
# Employee Management System — Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Database (PostgreSQL)
POSTGRES_DB=employee_management
POSTGRES_USER=postgres
POSTGRES_PASSWORD=user
POSTGRES_PORT=5432

# Object Storage (MinIO)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET=employee-files
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# Identity & Access Management (Keycloak)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=9090
KEYCLOAK_REALM=employee-management
KEYCLOAK_FRONTEND_CLIENT_ID=emp-frontend
KEYCLOAK_BACKEND_CLIENT_ID=app-backend
KEYCLOAK_BACKEND_CLIENT_SECRET=emp-backend-secret-2026

# Email Delivery (Mailtrap / SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=abdelhamidBassou
MAIL_PASSWORD=Watchmemoving123?

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=5173
