spring.application.name=employee-management
spring.datasource.url=jdbc:postgresql://localhost:5432/employee_management
spring.datasource.username=postgres
spring.datasource.password=YOUR_DB_PASSWORD
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

# MinIO
minio.endpoint=http://localhost:9000
minio.access-key=minioadmin
minio.secret-key=minioadmin
minio.bucket=employee-files

# File uploads
spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# Email (Mailtrap sandbox)
spring.mail.host=sandbox.smtp.mailtrap.io
spring.mail.port=2525
spring.mail.username=${SPRING_MAIL_USERNAME}
spring.mail.password=${SPRING_MAIL_PASSWORD}
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

app.frontend-url=http://localhost:5173

# Keycloak — OAuth2 Resource Server
spring.security.oauth2.resourceserver.jwt.issuer-uri=http://localhost:9090/realms/employee-management
spring.security.oauth2.resourceserver.jwt.jwk-set-uri=http://localhost:9090/realms/employee-management/protocol/openid-connect/certs

# Keycloak Admin API (used by DataSeeder and UserService to provision users)
keycloak.admin.server-url=http://localhost:9090
keycloak.admin.realm=employee-management
keycloak.admin.client-id=app-backend
keycloak.admin.client-secret=REPLACE_WITH_REAL_SECRET
